.page-wrap {
  padding: 24rpx; 
}
/*搜索框样式*/
.search-container {
  background-color: #ffffff;
  border-radius: 50rpx; 
  padding: 16rpx 30rpx;
  margin-bottom: 5rpx;
  display: flex;
  align-items: center;
}
.search-input {
  font-size: 26rpx;
  color: #333;
  flex: 1;
  height: 100%;
}
.search-img{
  width: 36rpx;
  height: 36rpx;
  margin-right: 20rpx;
}

/* -------- 轮播Banner样式 -------- */
.banner-swiper {
  width: 100%;
  border-radius: 20rpx; /* 图片圆角 */
  overflow: hidden;
  height: 360rpx;
}
.banner-img {
  width: 100%;
  object-fit: contain;
}

/*-----导航样式-----*/
.box-row{
  display: flex;
  justify-content: space-around;
  padding: 20rpx;
}
.box-row view image{
  width: 37px;
  height: 37px;
  text-align: center;
  line-height: 100px;
}
.box-wrap{
  display: flex;
  flex-direction: column;
  align-items: center;
}
.icon-img{
  width: 90rpx;
  height: 90rpx;
}
/*-----天气板块-----*/
.weather{
  position: relative;
  width: 90%;
  height: 200rpx;
  display: flex;
  justify-content: center;
  margin: 0 auto;
}
.weather-img{
  width: 100%;
  height: 200rpx;
}
.weather-tx{
  position: absolute;
  top: 10rpx;
  left: 10rpx;

}