<!-- 搜索框 -->
<view class="page-wrap">
  <view class="search-container">
    <image src="/pages/images/搜索.svg" class="search-img"></image>
    <input class="search-input"   placeholder="请输入关键字"  placeholder-style="color:#999"/>
  </view>
</view>

<!-- 轮播图 -->
<view>
<swiper class="banner-swiper" indicator-dots circular autoplay interval="3000" duration="500">
    <swiper-item>
      <image src="/pages/images/sw1.png" class="banner-img" mode="widthFix"></image>
    </swiper-item>
    <swiper-item>
      <image src="/pages/images/sw2.png" class="banner-img" mode="widthFix"></image>
    </swiper-item>
    <swiper-item>
      <image src="/pages/images/sw3.png" class="banner-img" mode="widthFix"></image>
    </swiper-item>
    <swiper-item>
      <image src="/pages/images/sw4.png" class="banner-img" mode="widthFix"></image>
    </swiper-item>
  </swiper>
  </view>

  <!-- 导航栏 -->
<view class="box-row" scroll-y>
  <view  class="box-wrap" scroll-x>
   <image src="/pages/images/卷轴-2.svg"></image>
   <text>地图</text>
  </view>
  <view class="box-wrap" scroll-x>
   <image src="/pages/images/玉如意.svg"></image>
   <text>文化</text>
  </view>
  <view class="box-wrap" scroll-x>
   <image src="/pages/images/香囊.svg"></image>
   <text>美食</text>
  </view>
  <view class="box-wrap" scroll-x>
   <image src="/images/玉佩-2.svg"></image>
   <text>游玩</text>
  </view>
</view>

<!-- 天气模块 -->
<view class="weather">
 <image src="/images/天气.png" class="weather-img"></image>
 <text class="weather-tx">青城山天气实况<br/>晴 19°/29° 空气良90</text>
</view>

<!-- 门票模块 -->
<view>
  <view class="title">门票</view>
  <view class="scroll-row" scroll-y>
    <view class="ticket-item">
      <image src="/images/tk1.jpg" mode="aspectFill"></image>
      <text>青城山前山门票</text>
      <text class="price">¥40起</text>
    </view>
    <view class="ticket-item">
      <image src="/images/tk2.jpg" mode="aspectFill"></image>
      <text>青城山后山门票</text>
      <text class="price">¥40起</text>
    </view>
    <view class="ticket-item">
      <image src="/images/tk3.jpg" mode="aspectFill"></image>
      <text>青城山套餐门票</text>
      <text class="price">¥80起</text>
    </view>
  </view>
  </view>

  <!-- 文化资讯模块 -->
<view class="news-box">
  <view class="title">文化资讯</view>
  <view class="news-card">
    <image src="/images/zixun.jpg"></image>
    <view class="news-text">
      <text class="news-title">问道青城山｜国家级非遗·青城武术</text>
      <text class="news-desc">坐落于都江堰的青城山，既是道教圣地，也孕育出中华传统武术重要流派 青城武术 2021 年列入国家级非物质文化遗产名录。</text>
    </view>
  </view>
</view>