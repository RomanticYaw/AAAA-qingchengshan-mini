/* pages/foodIntro/foodIntro.wxss */
.food-page {
  background-color: #f8f3e4;
  padding: 5rpx;
  min-height: 20vh;
}
/*欢迎部分*/
.welcome-header{
  position:relative;
  overflow: hidden;
  padding:80rpx 20rpx;
  text-align: center;
}
.welcome-header::before{
  content:"";
  position:absolute;
  left:0;
  top:0;
  width:100%;
  height:100%;
  background-color: rgba(245, 238, 226, 0.55);
  z-index:1;
}
.bg-img{
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.35; 
  z-index: 1;
}
.text-wrap{
  position: relative;
  z-index: 2;
}
.welcome-text{
  font-size:54rpx;
  color:#382a1e; 
  letter-spacing: 8rpx;
  text-shadow: 0rpx 0rpx 4rpx rgba(255,255,255,0.85);
  position: relative;
  z-index: 2;
  font-weight: 600;
  font-style: italic;
}
.welcome-titlle{
  font-size:48rpx;
  color:#2e2218;
  margin-top:20rpx;
  letter-spacing: 10rpx;
  text-shadow: 0rpx 0rpx 4rpx rgba(255,255,255,0.85);
  position: relative;
  z-index: 2;
  font-weight: 700;
}

/*美食介绍*/
.food-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  gap: 20rpx;
}
.card-hover {
  background-color: #f0ebe0 !important;
}
.food-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
 flex-shrink: 0;
}
.food-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.food-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #332211;
  margin-bottom: 6rpx;
}

.food-desc {
  font-size: 26rpx;
  color: #555;
  line-height: 1.5;
}
