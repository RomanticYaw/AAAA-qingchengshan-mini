/* pages/foodIntro/foodIntro.wxss */

/*欢迎部分*/
.welcome-header{
  position:relative;
  overflow: hidden;
  padding:80rpx 20rpx;
  text-align: center;
}
.bg-img{
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.35; 
  z-index: 1;
}
.text-wrap{
  position: relative;
  z-index: 2;
}
.welcome-text{
  font-size: 60rpx;
  color: #333;
  display:block;
  margin-bottom:16rpx;
}
.welcome-titlle{
  font-size:32rpx;
  color:#333;
  display:block;
}

